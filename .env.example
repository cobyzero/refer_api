# Server
PORT=3000
HOST_PORT=3001

# Database - PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=refer
DB_SSLMODE=disable
DB_EXTERNAL_PORT=5432

# Pool tuning (optional)
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_SEC=300

# Supabase Auth (único flujo; el server no arranca sin estas 4) — todo server-side,
# nunca en Flutter/Git.
#
# Dentro de docker compose, SUPABASE_URL default = http://supabase-kong:8000
# (red interna). Para `go run` local usa: SUPABASE_URL=http://localhost:8000
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# Admin seed (admin@admin.com): se aprovisiona en Supabase Auth al arrancar.
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=admin123@
# URL pública (links de email de Auth). En prod: https://tu-dominio:8000
SUPABASE_PUBLIC_URL=http://localhost:8000
# URL del sitio para redirects de Auth (GOTRUE_SITE_URL requerido).
SUPABASE_SITE_URL=http://localhost:3000
#
# --- Supabase Self-Hosted (docker compose) ---
# VALORES DEV por defecto en el compose. En PROD genera los tuyos y rotalos:
#   openssl rand -hex 16            # SUPABASE_POSTGRES_PASSWORD (solo letras/números)
#   openssl rand -base64 48         # SUPABASE_JWT_SECRET (min 32 chars)
# y firma ANON/SERVICE_ROLE HS256 con ese secret (iss supabase-demo, exp largo).
# Dev defaults (NO usar en prod):
#   SUPABASE_POSTGRES_PASSWORD=supabase-dev-pg-pass-01
#   SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
#   SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
#   SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
SUPABASE_POSTGRES_PASSWORD=
# DB externa supabase/postgres (proyecto refer-db separado, este repo no crea PG).
# Mismo password en ambos projects, solo [A-Za-z0-9-], fijado una vez.
DB_HOST_EXTERNAL=149.202.62.87
DB_PORT_EXTERNAL=5433
SUPABASE_KONG_HTTP_PORT=8000
SUPABASE_KONG_HTTPS_PORT=8443
# Storage (archivos): límite por archivo en bytes (default 50MB)
SUPABASE_STORAGE_FILE_LIMIT=52428800
GOTRUE_JWT_EXP=3600
SUPABASE_MAILER_AUTOCONFIRM=false
# OTP email: expiración del código en segundos (600 = 10 min).
SUPABASE_MAILER_OTP_EXP=600
# Plantilla del correo OTP (repo: supabase/templates/confirmation.html).
# GoTrue la descarga por HTTP; default = Go del compose (DNS interno).
# Solo cambiar para `go run` local fuera del compose:
# SUPABASE_MAILER_TEMPLATE_CONFIRMATION=http://host.docker.internal:3000/templates/confirmation.html
# SUPABASE_MAILER_TEMPLATE_CONFIRMATION=http://app:3000/templates/confirmation.html
# SMTP (Resend) para OTP de verificación + recovery de Auth:
# 1. Crea API key en https://resend.com/api-keys (empieza con re_)
# 2. Verifica tu dominio o usa onboarding@resend.dev para pruebas
SMTP_ADMIN_EMAIL=noreply@tu-dominio.com
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxx
SMTP_SENDER_NAME=Refer App
# Toggles de email OTP (alternativa al módulo de refer_web): cuando se definen
# bloquean el valor de la DB (el módulo web los muestra pero no mandan).
# Vacío/comentado = decide la DB (defaults true = OTP activo).
# Con SIGNUP_EMAIL_ENABLED=false la API auto-confirma cuentas en
# registro/login (devuelve sesión, sin OTP) y refer_app salta la vista OTP.
#SMTP_ENABLED=true
#SIGNUP_EMAIL_ENABLED=true
#RECOVERY_EMAIL_ENABLED=true
# DB principal: PG externa supabase/postgres (tiene prioridad sobre DB_HOST/DB_PORT/...).
# Ej: postgres://postgres:xxx@149.202.62.87:5433/postgres?sslmode=disable
DATABASE_URL=

# Stripe
STRIPE_SECRET_KEY=sk_test_51OdiwLBVQCFU1ZTsHF6mrgGGGqW8f5oMwXtkYBL4Cw88qUJDceDY2zoGsu4wn0ORt0FiwREpfMqesxmSfRHSihJt00rvsdqWKX

# App versions (GET /config -> version/minVersion).
# The Flutter app forces an update when installed < APP_MIN_VERSION
# and suggests one when installed < APP_VERSION.
# APP_MIN_VERSION defaults to APP_VERSION when unset.
APP_VERSION=1.0.0
APP_MIN_VERSION=1.0.0

# CORS
CORS_ORIGINS=http://localhost:4200,https://refer.cobyzero.com,https://refer-api.cobyzero.com
