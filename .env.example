# Server
PORT=3000
HOST_PORT=3001

# Database - PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=refer
DB_SSLMODE=disable
DB_EXTERNAL_PORT=5432

# Pool tuning (optional)
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_SEC=300

# Ory Kratos (único flujo auth; el server no arranca sin KRATOS_* + AUTH_JWT_SECRET).
# En compose Go usa http://kratos:4433/4434 (red interna); `go run` local usa
# localhost (puertos bindeados a 127.0.0.1). Todo server-side, nunca en Flutter/Git.
KRATOS_PUBLIC_URL=http://localhost:4433
KRATOS_ADMIN_URL=http://localhost:4434
AUTH_JWT_SECRET=
AUTH_JWT_EXP_SEC=3600
AUTH_REFRESH_TTL_DAYS=30
KRATOS_SECRETS_CIPHER=
KRATOS_SECRETS_COOKIE=
KRATOS_PUBLIC_PORT=4433
KRATOS_ADMIN_PORT=4434
# Admin seed (admin@admin.com): se aprovisiona en Kratos al arrancar.
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=admin123@
#
# --- PG externa (docker compose + `go run`) ---
# Mismo password en proyecto refer-db y aquí, solo [A-Za-z0-9-], fijado una vez.
# Generar secretos una vez (nunca commitear valores reales):
#   openssl rand -hex 16      # DB_PASSWORD
#   openssl rand -base64 48   # AUTH_JWT_SECRET
#   openssl rand -hex 16      # KRATOS_SECRETS_CIPHER (32 hex chars)
#   openssl rand -hex 32      # KRATOS_SECRETS_COOKIE (64 hex chars)
DB_PASSWORD=
DB_HOST_EXTERNAL=149.202.62.87
DB_PORT_EXTERNAL=5433
# SMTP (Resend) para OTP de Kratos (courier):
# 1. Crea API key en https://resend.com/api-keys (empieza con re_)
# 2. Verifica tu dominio o usa onboarding@resend.dev para pruebas
SMTP_ADMIN_EMAIL=noreply@tu-dominio.com
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxx
SMTP_SENDER_NAME=Refer App
# URI SMTP completa para Kratos courier. Ej Resend:
# KRATOS_SMTP_URI=smtp://resend:re_xxx@smtp.resend.com:587/
# Vacío = placeholder local (los envíos fallan con 503 hasta configurarlo).
KRATOS_SMTP_URI=
# Toggles de email OTP (alternativa al módulo de refer_web): cuando se definen
# bloquean el valor de la DB (el módulo web los muestra pero no mandan).
# Vacío/comentado = decide la DB (defaults true = OTP activo).
# Con SIGNUP_EMAIL_ENABLED=false la API auto-confirma cuentas en
# registro/login (devuelve sesión, sin OTP) y refer_app salta la vista OTP.
#SMTP_ENABLED=true
#SIGNUP_EMAIL_ENABLED=true
#RECOVERY_EMAIL_ENABLED=true
# DB principal: PG externa (tiene prioridad sobre DB_HOST/DB_PORT/...).
# Ej: postgres://postgres:xxx@149.202.62.87:5433/postgres?sslmode=disable
DATABASE_URL=
# --- Cloudflare R2 (S3-compatible) para uploads. Buckets uploads/products/
# avatars creados en el dashboard con acceso público. Sin esto, disco local.
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_UPLOADS_URL=
R2_PUBLIC_PRODUCTS_URL=
R2_PUBLIC_AVATARS_URL=

# Stripe
STRIPE_SECRET_KEY=sk_test_51OdiwLBVQCFU1ZTsHF6mrgGGGqW8f5oMwXtkYBL4Cw88qUJDceDY2zoGsu4wn0ORt0FiwREpfMqesxmSfRHSihJt00rvsdqWKX

# App versions (GET /config -> version/minVersion).
# The Flutter app forces an update when installed < APP_MIN_VERSION
# and suggests one when installed < APP_VERSION.
# APP_MIN_VERSION defaults to APP_VERSION when unset.
APP_VERSION=1.0.0
APP_MIN_VERSION=1.0.0

# CORS
CORS_ORIGINS=http://localhost:4200,https://refer.cobyzero.com,https://refer-api.cobyzero.com
